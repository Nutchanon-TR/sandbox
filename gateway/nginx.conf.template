log_format gateway_log '[$time_local] $remote_addr - $request "$status" $body_bytes_sent '
                       'upstream: $upstream_addr '
                       'upstream_status: $upstream_status '
                       'upstream_time: $upstream_response_time '
                       'upstream_connect: $upstream_connect_time '
                       'upstream_header: $upstream_header_time '
                       'request_time: $request_time '
                       'req_content_length: "$http_content_length" '
                       'User-Agent: "$http_user_agent"';

access_log /dev/stdout gateway_log;
error_log  /dev/stderr warn;

upstream frontend {
    server frontend:${FRONTEND_PORT};
}

upstream chat-service {
    server chat-service:${BACKEND_PORT};
}

upstream bpost-service {
    server bpost-service:${BPOST_PORT};
}

upstream user-service {
    server user-service:${BACKEND_PORT};
}

upstream oauth2-proxy {
    server oauth2-proxy:${OAUTH2_PROXY_PORT};
}

server {
    listen 80;
    server_name localhost;

    # Use HTTP/1.1 for all proxy requests to Envoy (ACA internal ingress rejects HTTP/1.0 with 426)
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # Increase proxy buffer sizes to handle large response headers
    # (Supabase auth sets large JWT cookies that exceed Nginx's default 4k/8k buffer)
    proxy_buffer_size          128k;
    proxy_buffers              4 256k;
    proxy_busy_buffers_size    256k;

    # ----------------------------------------
    # Error Pages
    # ----------------------------------------
    proxy_intercept_errors on;
    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/json;
        return 429 '{"error": "Too Many Requests", "message": "Rate limit exceeded. Please try again later."}';
    }

    # ----------------------------------------
    # OAuth2 Proxy Endpoints
    # ----------------------------------------
    # Auth subrequest endpoint — exact match wins over /oauth2/ prefix.
    # Strip parent request's body + Content-Length so oauth2-proxy doesn't block
    # waiting for bytes that auth_request never forwards (causes 60s upstream timeout).
    location = /oauth2/auth {
        proxy_pass              http://oauth2-proxy;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        Host                    $proxy_host;
        proxy_set_header        X-Forwarded-Host        $host;
        proxy_set_header        X-Real-IP               $remote_addr;
        proxy_set_header        X-Scheme                $scheme;
        proxy_set_header        X-Auth-Request-Redirect $request_uri;
    }

    location /oauth2/ {
        proxy_pass       http://oauth2-proxy;
        proxy_set_header Host                    $proxy_host;
        proxy_set_header X-Forwarded-Host        $host;
        proxy_set_header X-Real-IP               $remote_addr;
        proxy_set_header X-Scheme                $scheme;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }

    # ----------------------------------------
    # Frontend Routes
    # ----------------------------------------
    location / {
        proxy_pass http://frontend;
        # In Azure Container Apps Envoy, the Host header MUST match the internal container app name.
        # Nginx sets Host to $proxy_host by default ("frontend"), which ACA accepts.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # ----------------------------------------
    # Backend API Routes
    # ----------------------------------------
    # Chat Service
    location /v1/api/chat-app/ {
        auth_request /oauth2/auth;
        error_page 401 = @unauthorized;
        auth_request_set $user $upstream_http_x_auth_request_user;
        proxy_set_header X-User-Id $user;
        proxy_set_header Authorization $http_authorization;

        proxy_pass http://chat-service/v1/api/chat-app/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # B-Post Service — WebSocket (STOMP over SockJS)
    # Must come BEFORE the generic /v1/api/b-post/ rule (most specific wins).
    # No auth_request: STOMP CONNECT carries the JWT in its own frame.
    location /v1/api/b-post/ws/ {
        proxy_pass http://bpost-service/v1/api/b-post/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # B-Post Service (Image/Storage)
    location /v1/api/b-post/ {
        auth_request /oauth2/auth;
        error_page 401 = @unauthorized;
        auth_request_set $user $upstream_http_x_auth_request_user;
        proxy_set_header X-User-Id $user;
        proxy_set_header Authorization $http_authorization;

        proxy_pass http://bpost-service/v1/api/b-post/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # User Service
    # NOTE: dev (localhost) สามารถยิงตรงเข้า prod gateway ได้ (ใช้ Bearer JWT จาก Supabase)
    # ต้องเปิด CORS + bypass auth_request สำหรับ OPTIONS preflight
    location /v1/api/user/ {
        # Echo origin กลับเฉพาะ localhost (dev) — ป้องกัน arbitrary cross-origin
        set $cors_origin "";
        if ($http_origin ~* "^https?://localhost(:[0-9]+)?$") {
            set $cors_origin $http_origin;
        }

        # CORS preflight — return ก่อน auth_request เพราะ OPTIONS ไม่ส่ง Authorization
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, sourceSystem" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }

        auth_request /oauth2/auth;
        error_page 401 = @unauthorized;
        auth_request_set $user $upstream_http_x_auth_request_user;
        proxy_set_header X-User-Id $user;
        proxy_set_header Authorization $http_authorization;

        proxy_pass http://user-service/v1/api/user/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # Strip CORS headers จาก upstream — ให้ nginx เป็น single source of truth
        # (ถ้าปล่อยผ่าน + add_header ด้านล่าง จะได้ header ซ้ำ 2 ค่า → browser reject)
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;

        # CORS headers บน actual response (ใช้ always เพื่อให้ติดทุก status code)
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
    }

    location @unauthorized {
        return 302 /login;
    }
}
