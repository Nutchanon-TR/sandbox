# ============================================================
# frontend/.env.example — template สำหรับ frontend environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ============================================================

# ── OAuth Providers (NextAuth) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# ── Supabase ───────────��──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─��� API ──────���────────────────────────────────────────
# local dev: ปล่อยว่างให้ Next.js proxy /v1/api/* ผ่าน next.config.ts rewrites
NEXT_PUBLIC_API_URL=
# ชี้ไปหา Spring Boot backend (ใช้ใน next.config.ts เท่านั้น ไม่ expose ออก browser)
BACKEND_URL=http://localhost:8080

# ── Site URL ──────────────────────────────────────────
# Site URL สำหรับ Supabase OAuth redirectTo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth redirect URL — dev ชี้ไป prod gateway เพราะ login ใช้ prod Supabase auth
# production ไม่ต้องใส่ → fallback ไป NEXT_PUBLIC_SITE_URL อัตโนมัติ
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://gateway-service.<env>.<region>.azurecontainerapps.io

# user-service base URL — dev ชี้ไป prod gateway (login ใช้ prod Supabase auth)
# production ปล่อยว่าง → fallback ไป NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USER_API_URL=https://gateway-service.<env>.<region>.azurecontainerapps.io
