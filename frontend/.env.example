# frontend/.env.example
# Copy this file to frontend/.env.local and fill in real values.

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local dev API routing.
# Leave NEXT_PUBLIC_API_URL empty so browser calls stay relative and Next.js rewrites route them.
NEXT_PUBLIC_API_URL=
BACKEND_USER_URL=http://localhost:8080
BACKEND_CHAT_URL=http://localhost:8081
BACKEND_DINNER_URL=http://localhost:8082
BACKEND_BPOST_URL=http://localhost:8083

# Supabase OAuth redirect target for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_REDIRECT_URL=

# Local dev should keep this empty so user APIs go through Next.js rewrites.
NEXT_PUBLIC_USER_API_URL=

# Cloud login/API values kept here for quick switching when needed.
# CLOUD_NEXT_PUBLIC_AUTH_REDIRECT_URL=https://gateway-service.<env>.<region>.azurecontainerapps.io
# CLOUD_NEXT_PUBLIC_USER_API_URL=https://gateway-service.<env>.<region>.azurecontainerapps.io
