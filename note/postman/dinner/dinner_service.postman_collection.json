{
  "info": {
    "_postman_id": "2da86488-3c8e-4240-8492-8db92f0cbd32",
    "name": "Sandbox - Dinner Service",
    "description": "Mock requests for backend/dinner supplier order inquiry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Supplier Inquiry",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "sourceSystem",
            "value": "{{sourceSystem}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{dinnerBaseUrl}}/supplier/inquiry?page={{page}}&size={{pageSize}}"
      }
    },
    {
      "name": "Supplier Inquiry - Sort Desc",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "sourceSystem",
            "value": "{{sourceSystem}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{dinnerBaseUrl}}/supplier/inquiry?page={{page}}&size={{pageSize}}&sort[0].field=id&sort[0].direction=desc"
      }
    }
  ]
}
