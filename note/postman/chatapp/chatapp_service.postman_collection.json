{
  "info": {
    "_postman_id": "a1221faf-73db-4c33-8d26-9de5cdd96dc1",
    "name": "Sandbox - Chat App Service",
    "description": "Mock requests for backend/chatapp. Most write actions resolve the caller from Authorization Bearer JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Rooms",
      "item": [
        {
          "name": "List Rooms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{chatAppBaseUrl}}/room/list"
          }
        },
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mock AI Room\",\n  \"isGroup\": false,\n  \"systemPrompt\": \"You are a concise assistant for local API testing.\"\n}"
            },
            "url": "{{chatAppBaseUrl}}/room/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.environment.set('roomId', json.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI Chat",
      "item": [
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{chatAppBaseUrl}}/chat/history/{{roomId}}?limit=20"
          }
        },
        {
          "name": "Send Chat Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"message\": \"Summarize this mock API request in one sentence.\"\n}"
            },
            "url": "{{chatAppBaseUrl}}/chat"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.reply) pm.environment.set('lastAiReply', json.reply);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
