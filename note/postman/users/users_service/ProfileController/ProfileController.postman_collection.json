{
  "info": {
    "_postman_id": "153961d5-699d-0e7b-73f9-213fa4087845",
    "name": "Sandbox - users_service - ProfileController",
    "description": "User profile APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "sourceSystem",
            "value": "{{sourceSystem}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{usersBaseUrl}}/profile/{{supabaseUid}}",
        "description": "Read profile by Supabase UID."
      }
    },
    {
      "name": "Create Or Update Profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "sourceSystem",
            "value": "{{sourceSystem}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usersBaseUrl}}/profile",
        "description": "Create or update a user profile.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"supabaseUid\": \"{{supabaseUid}}\",\n  \"username\": \"{{username}}\",\n  \"email\": \"{{userEmail}}\"\n}"
        }
      }
    }
  ]
}
