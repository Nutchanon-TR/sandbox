{
  "info": {
    "_postman_id": "73854b0f-b7a5-7e60-75d7-742e2576a3e0",
    "name": "Sandbox - bpost_service - PresenceController",
    "description": "B-Post presence APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Online Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "sourceSystem",
            "value": "{{sourceSystem}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{bpostBaseUrl}}/presence/online",
        "description": "List internal user ids that are currently online."
      }
    }
  ]
}
