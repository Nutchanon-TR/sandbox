{
  "info": {
    "_postman_id": "eac4422d-81be-73f5-a672-00e8a6950ac8",
    "name": "Sandbox - bpost_service - ReportController",
    "description": "Legacy B-Post image upload APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Upload Blog Image",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "sourceSystem",
            "value": "{{sourceSystem}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{bpostBaseUrl}}/blog/upload-image",
        "description": "Upload a legacy blog image.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "imageFile",
              "type": "file",
              "src": "{{imageFilePath}}"
            }
          ]
        }
      }
    }
  ]
}
