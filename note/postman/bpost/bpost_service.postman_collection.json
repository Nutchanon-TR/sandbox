{
  "info": {
    "_postman_id": "d8b2ec3d-e698-4e52-a83b-ef61664555f5",
    "name": "Sandbox - B-Post Service",
    "description": "Mock requests for backend/bpost posts, comments, friends, messages, notifications, presence, and image uploads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "Upload Post Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imageFile",
                  "type": "file",
                  "src": "{{imageFilePath}}"
                }
              ]
            },
            "url": "{{bpostBaseUrl}}/posts/upload-image"
          }
        },
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello from Postman mock data\",\n  \"imageUrls\": [\n    \"https://example.com/mock-post-image.png\"\n  ],\n  \"visibility\": \"PUBLIC\"\n}"
            },
            "url": "{{bpostBaseUrl}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.environment.set('postId', json.id);",
                  "  if (json.author && json.author.id) pm.environment.set('authorId', json.author.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Feed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{bpostBaseUrl}}/posts/feed?limit=20"
          }
        },
        {
          "name": "Posts By Author",
          "request": {
