        },
        {
          "name": "Unlike Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "sourceSystem",
                "value": "{{sourceSystem}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{bpostBaseUrl}}/posts/{{postId}}/likes"
