# ============================================================
# .env.example — template สำหรับ environment variables ทั้งหมด
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงก่อนรัน docker-compose
# ============================================================

# ── Supabase Database ──────────────────────────────────────
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

# ── Supabase API ───────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL ใช้ใน chatapp/bpost/user สำหรับ REST API
SUPABASE_URL=https://<project-id>.supabase.co

# ── User Service ───────────────────────────────────────
# ใช้ SUPABASE_DB_USERNAME / SUPABASE_DB_PASSWORD ร่วมกับ backend services อื่น

# ── AI Services ────────────────────────────────────────────
GROK_API_KEY=
HUGGINGFACE_API_KEY=

# ── Frontend ───────────────────────────────────────────────
# ใส่ production URL เมื่อ deploy (ใช้กับ Supabase OAuth redirectTo)
NEXT_PUBLIC_SITE_URL=https://gateway-service.<env>.<region>.azurecontainerapps.io
# Auth redirect URL — dev ชี้ไป prod gateway เพราะ login ใช้ prod Supabase auth
# production ไม่ต้องใส่ → fallback ไป NEXT_PUBLIC_SITE_URL อัตโนมัติ
NEXT_PUBLIC_AUTH_REDIRECT_URL=

# user-service base URL — dev ชี้ไป prod gateway (login ใช้ prod Supabase auth)
# production ปล่อยว่าง → fallback ไป NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USER_API_URL=

# ── OAuth2 Proxy (ต้องใช้เมื่อ uncomment auth_request ใน nginx) ──
SUPABASE_PROJECT_ID=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# สร้างด้วย: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
