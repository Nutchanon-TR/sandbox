# ============================================================
# .env.example — template สำหรับ environment variables ทั้งหมด
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงก่อนรัน docker-compose
# ============================================================

# ── Supabase Database ──────────────────────────────────────
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

# ── Supabase API ───────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_UPL ใช้ใน chatapp/bpost สำหรับ REST API
SUPABASE_UPL=https://<project-id>.supabase.co

# ── AI Services ────────────────────────────────────────────
GROK_API_KEY=
HUGGINGFACE_API_KEY=

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=

# ── OAuth2 Proxy (ต้องใช้เมื่อ uncomment auth_request ใน nginx) ──
SUPABASE_PROJECT_ID=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# สร้างด้วย: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
